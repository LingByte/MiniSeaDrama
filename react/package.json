{
  "name": "haiman-script-mall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "海漫剧本商城与后台管理（前端 + Node 后端）",
  "scripts": {
    "dev": "node scripts/gen-seed.mjs && vite",
    "build": "node scripts/gen-seed.mjs && vite build --outDir web",
