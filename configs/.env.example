# miniseadrama environment variables reference
# Copy this file to .env and fill in actual values: cp configs/.env.example configs/.env
# All config is injected via env vars, format: APP_<SECTION>_<FIELD>=VALUE

# ── App ──
APP_APP_NAME=miniseadrama
APP_APP_ENVIRONMENT=dev

# ── Server ──
APP_SERVER_PORT=8080

# ── Database ──
APP_DATABASE_DRIVER=mysql
APP_DATABASE_DSN="root:ct288513832##@tcp(cd-cynosdbmysql-grp-lfa6zfg0.sql.tencentcdb.com:23771)/miniseadrama?charset=utf8mb4&parseTime=True&loc=Local"
# MySQL（密码含 # 时请用双引号包住整段 DSN）:
# APP_DATABASE_DSN="user:pass@tcp(host:3306)/miniseadrama?charset=utf8mb4&parseTime=True&loc=Local"
# PostgreSQL example: APP_DATABASE_DSN=host=localhost user=postgres password=secret dbname=miniseadrama port=5432 sslmode=disable

# ── Redis ──
APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=

# ── JWT auth ──
APP_JWT_ENABLED=false
APP_JWT_SECRET=change-me-in-prod-32bytes!

# ── API docs ──
APP_DOCS_ENABLED=true

# ── Rate limiting ──
APP_RATELIMIT_ENABLED=false
APP_RATELIMIT_RPS=100

# ── Internationalization ──
APP_I18N_ENABLED=true
APP_I18N_DEFAULT_LOCALE=zh-CN
APP_I18N_FALLBACK_LOCALE=en
APP_I18N_TRANSLATIONS_PATH=i18n/translations

# ── Object storage (ling-base/stores) ──
# 对象存储：local（开发）或 qiniu（生产七牛）
# STORAGE_KIND=local
# APP_STORAGE_ROOT=uploads
STORAGE_KIND=qiniu
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=seadrama
QINIU_DOMAIN=https://soul.lingecho.com
QINIU_PRIVATE=true
QINIU_REGION=huanan
APP_STORAGE_MAX_FILE_SIZE=52428800
APP_STORAGE_DISPLAY_URL_TTL=24h
APP_STORAGE_DOWNLOAD_URL_TTL=15m

# ── Cache (ling-base/common/cache) ──
APP_CACHE_DRIVER=memory
APP_CACHE_DEFAULT_TTL=10m

# ── Distributed lock (ling-base/common/lock) ──
APP_LOCK_DRIVER=memory
APP_LOCK_DEFAULT_TTL=10s

# ── Retry strategy (ling-base/common/retry) ──
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_INITIAL_DELAY=100ms

# ── Fallback (pkg/fallback) ──
APP_FALLBACK_ENABLED=true
APP_FALLBACK_MESSAGE=service temporarily unavailable

# ── AI（剧本生成 + 封面生图；Base/模型名可展示给管理端，Key 不下发） ──
AI_BASE_URL=https://team.lingecho.com/v1
AI_API_KEY=
AI_TEXT_MODEL=claude-opus-5.5特价
AI_IMAGE_MODEL=tt-image-2.5

# ── 短剧生成服务（miniseadrama FastAPI） ──

# ── ShortFlix 自动登录（AI 快速生成自动获取会话 Cookie，无需前端手工填写） ──
SHORTFLIX_EMAIL=
SHORTFLIX_PASSWORD=

# ── Payment (Epay / ZPay via ling-base pkg/common/payment/epay) ──
# PayAddress / EpayId / EpayKey / EpayCheckoutMode / CustomCallbackAddress
EPAY_PARTNER_ID=
EPAY_KEY=
EPAY_BASE_URL=https://zpayz.cn
EPAY_CHECKOUT_MODE=api
PUBLIC_CALLBACK_BASE=https://drama.lingecho.com

# ── Admin seed (go run ./cmd/server -seed / make seed) ──
# Admins cannot be created via public registration.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_USERNAME=admin
